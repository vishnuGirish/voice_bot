// Digitalize ERP — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  createdAt     DateTime @default(now())
  dataSourceUrl String? // optional external Postgres connection string WAI reads from instead of this app's own tables
  enabledTables String[] @default([]) // allow-list of table names WAI may query in that external database
  userScopeColumns Json @default("{}") // { tableName: string[] } — columns that must match the caller's userId for that table to be readable at all
  companyScopeColumns Json @default("{}") // { tableName: string[] } — same idea, matched against the caller's companyId
  users      User[]
  staff      Staff[]
  clients    Client[]
  leads      Lead[]
  projects   Project[]
  invoices   Invoice[]
  expenses   Expense[]
  activityLogs ActivityLog[]
  apiKeys    ApiKey[]
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique
  passwordHash   String
  role           Role         @default(STAFF)
  staff          Staff?
  createdAt      DateTime     @default(now())
}

// ---------- HRMS ----------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  WORK_FROM_HOME
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Staff {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])
  name           String
  designation    String
  department     String
  email          String       @unique
  phone          String?
  joinedAt       DateTime     @default(now())
  active         Boolean      @default(true)
  attendances    Attendance[]
  leaves         Leave[]
  tasks          Task[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Attendance {
  id        String           @id @default(cuid())
  staffId   String
  staff     Staff            @relation(fields: [staffId], references: [id])
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  checkIn   DateTime?
  checkOut  DateTime?
  createdAt DateTime         @default(now())

  @@unique([staffId, date])
}

model Leave {
  id        String      @id @default(cuid())
  staffId   String
  staff     Staff       @relation(fields: [staffId], references: [id])
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  reason    String
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

// ---------- CRM / Sales Pipeline ----------

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  company        String?
  email          String?
  phone          String?
  notes          String?
  leads          Lead[]
  invoices       Invoice[]
  projects       Project[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  title          String
  value          Decimal      @default(0) @db.Decimal(12, 2)
  stage          LeadStage    @default(NEW)
  ownerName      String?
  expectedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// ---------- Projects ----------

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id])
  status         ProjectStatus @default(PLANNED)
  startDate      DateTime?     @db.Date
  dueDate        DateTime?     @db.Date
  tasks          Task[]
  createdAt      DateTime      @default(now())

  @@index([organizationId])
}

model Task {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  title     String
  status    TaskStatus @default(TODO)
  assigneeId String?
  assignee  Staff?     @relation(fields: [assigneeId], references: [id])
  dueDate   DateTime?  @db.Date
  createdAt DateTime   @default(now())
}

// ---------- Accounting ----------

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  number         String        @unique
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
}

enum ExpenseCategory {
  RENT
  SALARY
  SOFTWARE
  TRAVEL
  MARKETING
  OTHER
}

model Expense {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  title          String
  category       ExpenseCategory @default(OTHER)
  amount         Decimal         @db.Decimal(12, 2)
  incurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([organizationId])
}

// ---------- WAI Assistant ----------

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String // the org that issued/owns this key for attribution — irrelevant to access when isPlatformKey is true
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String       @unique
  label          String
  revoked        Boolean      @default(false)
  isPlatformKey  Boolean      @default(false) // if true, the caller must pass organizationId with each request instead of being locked to `organizationId` above
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?

  @@index([organizationId])
}

// ---------- Activity Logs ----------

enum LogCategory {
  AUTH
  HRMS
  CRM
  PROJECTS
  ACCOUNTING
  SYSTEM
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  actorName      String
  category       LogCategory
  action         String
  description    String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, category, createdAt])
  @@index([actorUserId, createdAt])
}
